{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || data.child('memberIds').child(auth.uid).exists() || data.child('status').val() === 'waiting' || data.child('createdAt').val() < (now - 10800000))",
        ".validate": "!newData.exists() || (newData.hasChildren(['id','hostId','createdAt']) && (!newData.child('name').exists() || (newData.child('name').isString() && newData.child('name').val().length <= 100)))"
      }
    },
    "gameStates": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('rooms').child($roomId).child('memberIds').child(auth.uid).exists() || (!root.child('rooms').child($roomId).exists() && !newData.exists()) || root.child('rooms').child($roomId).child('status').val() === 'finished' || root.child('rooms').child($roomId).child('createdAt').val() < (now - 10800000))"
      }
    },
    "towerDetails": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!root.child('rooms').child($roomId).exists() && !newData.exists()) || root.child('rooms').child($roomId).child('status').val() === 'finished' || root.child('rooms').child($roomId).child('createdAt').val() < (now - 10800000))",
        "$userId": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('memberIds').child(auth.uid).exists() && (auth.uid === $userId || $userId.matches(/^ai_/))"
        }
      }
    },
    "battleResults": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('rooms').child($roomId).child('memberIds').child(auth.uid).exists() || (!root.child('rooms').child($roomId).exists() && !newData.exists()) || root.child('rooms').child($roomId).child('status').val() === 'finished' || root.child('rooms').child($roomId).child('createdAt').val() < (now - 10800000))"
      }
    },
    "presence": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!root.child('rooms').child($roomId).exists() && !newData.exists()) || root.child('rooms').child($roomId).child('status').val() === 'finished' || root.child('rooms').child($roomId).child('createdAt').val() < (now - 10800000))",
        "$userId": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('memberIds').child(auth.uid).exists() && (auth.uid === $userId || $userId.matches(/^ai_/))",
          ".validate": "!newData.exists() || newData.hasChild('online')"
        }
      }
    }
  }
}
