# ──────────────────────────────────────────────────────────────
# Pokemon Aegis — 환경 변수 예시
# 이 파일을 복사해 `.env` 로 저장하고 값을 채우세요.  (cp .env.example .env)
# `.env` 는 .gitignore 에 포함되어 커밋되지 않습니다.
#
# 값은 Firebase Console → 프로젝트 설정(⚙) → 일반 → 내 앱 → SDK 설정 및 구성
# 의 firebaseConfig 객체에서 확인할 수 있습니다.
#
# 주의: VITE_ 로 시작하는 변수는 빌드 시 클라이언트 번들에 그대로 포함됩니다.
#       (Firebase 웹 설정값은 비밀키가 아니며 공개되어도 정상입니다.
#        실제 접근 제어는 Firestore/RTDB 보안 규칙과 승인된 도메인이 담당합니다.)
# ──────────────────────────────────────────────────────────────

# 필수 — Firebase 웹 앱 설정
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# 멀티플레이(Realtime Database)용. 미지정 시 SDK가
# https://<projectId>-default-rtdb.firebaseio.com 로 자동 유추하지만,
# 멀티 연결이 안 되면 콘솔의 실제 databaseURL 을 명시하세요.
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com

# 권장 — App Check (reCAPTCHA v3) 사이트 키
# 무료 플랜엔 Cloud Functions가 없어 서버측 유량 제어가 불가능합니다. 익명 로그인이
# 열려 있어 스크립트로 계정을 무한 생성하면 읽기/쓰기 쿼터를 외부에서 소진시킬 수
# 있는데, App Check는 Spark에서 무료로 "진짜 우리 웹앱의 요청인지"를 검증합니다.
#
# 설정 순서:
#   1) Firebase Console → 빌드 → App Check → 앱 등록 → reCAPTCHA v3 선택
#   2) 발급된 '사이트 키'를 아래에 입력 (비밀키 아님 — 공개되어도 무방)
#   3) App Check → API 탭에서 Firestore / Realtime Database '적용(enforce)' 켜기
#      ※ 3)을 켜기 전까지는 토큰만 붙고 실제 차단은 일어나지 않습니다.
#         배포본이 충분히 퍼진 뒤에 켜세요(구버전 클라이언트가 차단됩니다).
#   4) 로컬 개발은 DEV 빌드에서 자동으로 디버그 토큰 모드가 켜집니다.
#      브라우저 콘솔에 찍히는 토큰을 App Check → 앱 → 디버그 토큰 관리에 등록하세요.
# 비워두면 App Check가 완전히 비활성화됩니다(기존 동작 그대로).
VITE_FIREBASE_APPCHECK_SITE_KEY=

# 선택 — Sentry 에러 모니터링 (프로덕션 에러 가시성)
# Sentry 프로젝트 → Settings → Client Keys (DSN) 에서 확인.
# 비워두면 Sentry가 완전히 비활성화됩니다(번들에도 미포함 — 동적 로드).
# DSN은 클라이언트 공개값이라 노출되어도 무방하지만, 배포(Netlify) 환경변수에도
# 동일하게 넣어야 프로덕션 빌드에 적용됩니다.
VITE_SENTRY_DSN=
