rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── 유저 프로필 ─────────────────────────────────────
    // [SEC] rating은 클라이언트가 쓰지만(서버 권한 없음), 말도 안 되는 값(예: 9,999,999)으로
    //   PVP 리더보드를 도배하는 것을 상한으로 차단. 정상 ELO는 1000 기준 ±32/게임이라 5000이면 충분.
    //   (Spark 무료 플랜엔 Cloud Functions가 없어 완전한 서버 검증은 불가 — 이건 '벽 높이기'.)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && (!('rating' in request.resource.data)
                       || (request.resource.data.rating is number
                           && request.resource.data.rating >= 0
                           && request.resource.data.rating <= 5000));
    }

    // ─── 전당등록 ────────────────────────────────────────
    match /hallOfFame/{entry} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.wave is number
                    && request.resource.data.wave >= 0
                    && request.resource.data.wave <= 100
                    && request.resource.data.clearTime is number
                    && request.resource.data.clearTime >= 0
                    && (!('pokemonUsed' in request.resource.data)
                        || request.resource.data.pokemonUsed.size() <= 30);
      // 본인 기록만 수정/삭제 가능 (악용 방지)
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

    // ─── 리더보드 ────────────────────────────────────────
    match /leaderboards/{entry} {
      allow read: if request.auth != null;
      // 문서 ID 형식: ${userId}_${mapId} — 본인 ID로 시작하는 문서만.
      // [SEC] highestWave/rating 상한으로 가짜 기록(웨이브 9999 등) 차단.
      allow create, update: if request.auth != null
                            && request.resource.data.userId == request.auth.uid
                            && entry.matches(request.auth.uid + '_.*')
                            && (!('highestWave' in request.resource.data)
                                || (request.resource.data.highestWave is number
                                    && request.resource.data.highestWave >= 0
                                    && request.resource.data.highestWave <= 100))
                            && (!('rating' in request.resource.data)
                                || (request.resource.data.rating is number
                                    && request.resource.data.rating >= 0
                                    && request.resource.data.rating <= 5000));
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // ─── 업적 ────────────────────────────────────────────
    match /achievements/{docId} {
      // 문서가 없는 경우(resource == null)도 본인 UID 패턴이면 읽기 허용
      allow read: if request.auth != null
                  && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && docId.matches(request.auth.uid + '_.*');
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ─── AP 랭킹 ────────────────────────────────────────
    // [SEC] totalAP 상한으로 랭킹 위조 차단(전체 업적 합산 최대치도 수천 수준).
    match /apRankings/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.data.userId == request.auth.uid
                   && (!('totalAP' in request.resource.data)
                       || (request.resource.data.totalAP is number
                           && request.resource.data.totalAP >= 0
                           && request.resource.data.totalAP <= 100000));
    }

    // ─── 미니 포켓 랭킹 (트레이너 타워 최고층 / 수집 종 수) ──
    // [SEC] towerFloor·collectionCount 상한으로 위조 차단.
    //   수집은 최대 1025종(전 세대), 타워는 사실상 무한이나 비정상값 차단용 상한.
    match /cardRankings/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.data.userId == request.auth.uid
                   && (!('towerFloor' in request.resource.data)
                       || (request.resource.data.towerFloor is number
                           && request.resource.data.towerFloor >= 0
                           && request.resource.data.towerFloor <= 100000))
                   && (!('collectionCount' in request.resource.data)
                       || (request.resource.data.collectionCount is number
                           && request.resource.data.collectionCount >= 0
                           && request.resource.data.collectionCount <= 2000));
    }

    // ─── 미니 포켓 주간 시즌 타워 랭킹 ───────────────────
    // seasons/{seasonId}/cardRankings/{uid} — 주차별 서브컬렉션(경로 분리로 자동 리셋).
    // [SEC] 본인 문서만 쓰기, towerFloor 상한으로 위조 차단.
    match /seasons/{seasonId}/cardRankings/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.data.userId == request.auth.uid
                   && (!('towerFloor' in request.resource.data)
                       || (request.resource.data.towerFloor is number
                           && request.resource.data.towerFloor >= 0
                           && request.resource.data.towerFloor <= 100000));
    }

    // ─── 포켓몬 퀴즈 랭킹 (수능 모의고사 최고점, 최대 50점) ──
    // [SEC] examBest 상한(50)으로 위조 차단. 문항 수 10/30/50 선택 가능.
    match /quizRankings/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.data.userId == request.auth.uid
                   && (!('examBest' in request.resource.data)
                       || (request.resource.data.examBest is number
                           && request.resource.data.examBest >= 0
                           && request.resource.data.examBest <= 50));
    }

    // ─── 미니 포켓 랜덤 대전 덱 스냅샷 ────────────────────
    // 비동기 PvP: 모든 로그인 유저가 읽고(매칭), 본인 덱만 발행.
    // [SEC] deck 크기 상한 6. stars 등 항목별 값은 룰에서 리스트 순회가 불가하므로
    //   전투 빌드 시 클라이언트가 clamp(buildBattleCard가 별 1~5 강제) — 위조해도 ★5 초과 불가.
    match /cardDecks/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.data.userId == request.auth.uid
                   && request.resource.data.deck is list
                   && request.resource.data.deck.size() >= 1
                   && request.resource.data.deck.size() <= 6
                   && request.resource.data.rand is number
                   && request.resource.data.rand >= 0
                   && request.resource.data.rand <= 1;
    }

    // ─── 그 외 모든 경로 차단 ────────────────────────────
    // (rooms는 RTDB에 있으므로 Firestore에는 더 이상 정의하지 않음)
    // (pokedex는 사용처가 없으므로 제거됨)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
