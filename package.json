{
  "name": "pokemon-aegis",
  "private": true,
  "version": "4.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sim": "vitest run --config vitest.sim.config.ts --exclude \"sim/report/**\" && npm run sim:report",
    "sim:prefetch": "cross-env SIM_HTTP=record vitest run --config vitest.sim.config.ts sim/tools/prefetch.sim.ts",
    "sim:pvp": "vitest run --config vitest.sim.config.ts sim/pvp/pvpMatrix.sim.ts",
    "sim:placement": "vitest run --config vitest.sim.config.ts sim/pvp/placement.sim.ts",
    "sim:cross": "vitest run --config vitest.sim.config.ts sim/pvp/crossValidate.sim.ts",
    "sim:cards": "vitest run --config vitest.sim.config.ts sim/cards/cardBattle.sim.ts",
    "sim:parity": "vitest run --config vitest.sim.config.ts sim/parity/mechanics.sim.ts",
    "sim:determinism": "vitest run --config vitest.sim.config.ts sim/parity/determinism.sim.ts",
    "sim:fairness": "vitest run --config vitest.sim.config.ts sim/pvp/fairness.sim.ts",
    "sim:single": "vitest run --config vitest.sim.config.ts sim/single/single.sim.ts",
    "sim:multi": "vitest run --config vitest.sim.config.ts sim/multi/multi.sim.ts",
    "sim:report": "vitest run --config vitest.sim.config.ts sim/report/report.sim.ts",
    "sim:baseline": "node sim/tools/baseline.mjs",
    "sim:tune": "cross-env SIM_TUNE=1 vitest run --config vitest.sim.config.ts sim/tools/tune.sim.ts",
    "sim:validate": "cross-env SIM_VALIDATE=1 vitest run --config vitest.sim.config.ts sim/tools/validate.sim.ts",
    "sim:balance": "cross-env SIM_BALANCE=1 vitest run --config vitest.sim.config.ts sim/tools/balance.sim.ts",
    "sim:gold": "cross-env SIM_GOLD=1 vitest run --config vitest.sim.config.ts sim/tools/goldValue.sim.ts"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@sentry/react": "^10.64.0",
    "axios": "^1.6.2",
    "firebase": "^12.5.0",
    "howler": "^2.2.4",
    "konva": "^9.2.3",
    "lucide-react": "^1.21.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-konva": "^18.2.10",
    "react-router-dom": "^7.9.5",
    "styled-components": "^6.1.19",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/howler": "^2.2.11",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/styled-components": "^5.1.35",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "baseline-browser-mapping": "^2.10.8",
    "cross-env": "^10.1.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^4.1.10"
  }
}
